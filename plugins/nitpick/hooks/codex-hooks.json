{
  "description": "nitpick watch: background code review. Install globally with nitpick watch install codex --global, then enable and trust the four hooks in Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "nitpick hook codex tool",
            "statusMessage": "nitpick: schedule background review and deliver findings",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "nitpick hook codex session-start",
            "statusMessage": "nitpick: establish the review baseline",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "nitpick hook codex stop",
            "statusMessage": "nitpick: schedule remaining review; apply the configured stop policy",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "nitpick hook codex prompt",
            "statusMessage": "nitpick: deliver pending review findings",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
